# ─────────────────────────────────────────────
#  KS-Bank mockup .gitignore
# ─────────────────────────────────────────────

# 서드파티 벤더 다운로드 (재배포 라이선스 / 대용량)
#   → clone 후 backend-cobol/docker/vendor/README.md 참고해 직접 다운로드
backend-cobol/docker/vendor/*.zip
backend-cobol/docker/vendor/*.tar.gz

# 빌드 로그 / 산출물
backend-cobol/build/gixsql.log
*.log
*.o
*.so
*.int
*.gnt
*.lst
*.class

# Java / Maven (backend-java)
target/
*.jar
!backend-cobol/jef/jef4j.jar

# 야간배치 帳票 산출물 (COBOL 은 컨테이너 내 /app/build/data, Java 는 아래 디렉터리)
#   ※ 위 '*.lst' 규칙이 KOUZA.LST 를 이미 무시하므로, 디렉터리째 명시해 의도를 분명히 한다
backend-java/data/*
!backend-java/data/.gitkeep

# 파리티 대조 하네스 작업물
tools/parity/out/

# OS / 에디터 잡파일
.DS_Store
Thumbs.db
*.swp
*~
